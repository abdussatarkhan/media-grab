@{
    ViewData["Title"] = "FAQ";
}
<div class="container py-5" style="max-width: 720px;">
    <h1 class="h3 mb-4">Frequently asked questions</h1>

    <h2 class="h6">What can I submit?</h2>
    <p class="text-secondary small">Any HTTP or HTTPS URL. It will only be processed further if it matches an enabled, authorized provider.</p>

    <h2 class="h6">Does MediaGrab bypass DRM or paywalls?</h2>
    <p class="text-secondary small">No, and it never will. Content behind authentication, paywalls, or DRM is out of scope.</p>

    <h2 class="h6">Is downloading available yet?</h2>
    <p class="text-secondary small">Not yet - Phase 1 covers accounts, validation, and job tracking. Real downloading is Phase 2.</p>

    <h2 class="h6">How do I report an issue?</h2>
    <p class="text-secondary small">Use the <a asp-controller="Home" asp-action="Contact">contact page</a>.</p>
</div>
