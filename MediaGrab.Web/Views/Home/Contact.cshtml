@{
    ViewData["Title"] = "Contact";
}
<div class="container py-5" style="max-width: 640px;">
    <h1 class="h3 mb-3">Contact us</h1>
    <p class="text-secondary mb-4">A working contact form will be wired up in a later phase. In the meantime, reach the team via your project's usual support channel.</p>
    <form>
        <div class="mb-3">
            <label class="form-label" for="contactName">Name</label>
            <input class="form-control" id="contactName" disabled placeholder="Coming soon" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="contactEmail">Email</label>
            <input class="form-control" id="contactEmail" disabled placeholder="Coming soon" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="contactMessage">Message</label>
            <textarea class="form-control" id="contactMessage" rows="4" disabled placeholder="Coming soon"></textarea>
        </div>
        <button class="btn btn-primary" type="button" disabled>Send (Phase 2)</button>
    </form>
</div>
