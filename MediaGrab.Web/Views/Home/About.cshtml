@{
    ViewData["Title"] = "About";
}
<div class="container py-5" style="max-width: 720px;">
    <h1 class="h3 mb-3">About MediaGrab</h1>
    <p class="text-secondary">
        MediaGrab is a URL-analysis and authorized-download tool built on ASP.NET Core. It's designed from the
        ground up to respect platform access controls - it validates every URL, only works through explicit
        provider integrations, and never attempts to bypass DRM, authentication, or paywalls.
    </p>
</div>
